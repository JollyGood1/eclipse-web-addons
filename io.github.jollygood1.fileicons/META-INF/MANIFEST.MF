Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: %bundleName
Bundle-SymbolicName: io.github.jollygood1.fileicons;singleton:=true
Bundle-Version: 1.0.0.qualifier
Bundle-Vendor: %bundleVendor
