<?xml version="1.0" encoding="UTF-8"?>
<!--
  Tycho build: mvn clean verify
  Builds the two plug-ins, one feature for each, and an update site (p2 repository) in
  io.github.jollygood1.webaddons.site/target/repository.
  The plug-ins, features and the site have no pom.xml of their own: Tycho derives them from
  MANIFEST.MF, feature.xml and category.xml (see .mvn/extensions.xml).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>io.github.jollygood1</groupId>
	<artifactId>io.github.jollygood1.webaddons.parent</artifactId>
	<version>1.0.0-SNAPSHOT</version>
	<packaging>pom</packaging>

	<name>Eclipse Web Addons</name>
	<url>https://github.com/JollyGood1/eclipse-web-addons</url>
	<licenses>
		<license>
			<name>Eclipse Public License 1.0</name>
			<url>https://www.eclipse.org/legal/epl-v10.html</url>
		</license>
	</licenses>

	<properties>
		<!-- keep in step with .mvn/extensions.xml -->
		<tycho.version>5.0.4</tycho.version>
		<!-- the Eclipse release the plug-ins are compiled against -->
		<eclipse.release>2026-09</eclipse.release>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
	</properties>

	<modules>
		<module>io.github.jollygood1.syntaxthemes</module>
		<module>io.github.jollygood1.fileicons</module>
		<module>io.github.jollygood1.syntaxthemes.feature</module>
		<module>io.github.jollygood1.fileicons.feature</module>
		<module>io.github.jollygood1.webaddons.site</module>
	</modules>

	<repositories>
		<repository>
			<id>eclipse-release</id>
			<layout>p2</layout>
			<url>https://download.eclipse.org/releases/${eclipse.release}</url>
		</repository>
	</repositories>

	<build>
		<plugins>
			<plugin>
				<groupId>org.eclipse.tycho</groupId>
				<artifactId>tycho-maven-plugin</artifactId>
				<version>${tycho.version}</version>
				<extensions>true</extensions>
			</plugin>
			<plugin>
				<groupId>org.eclipse.tycho</groupId>
				<artifactId>target-platform-configuration</artifactId>
				<version>${tycho.version}</version>
				<configuration>
					<environments>
						<environment>
							<os>win32</os>
							<ws>win32</ws>
							<arch>x86_64</arch>
						</environment>
						<environment>
							<os>linux</os>
							<ws>gtk</ws>
							<arch>x86_64</arch>
						</environment>
						<environment>
							<os>macosx</os>
							<ws>cocoa</ws>
							<arch>aarch64</arch>
						</environment>
					</environments>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.eclipse.tycho</groupId>
				<artifactId>tycho-p2-repository-plugin</artifactId>
				<version>${tycho.version}</version>
				<configuration>
					<repositoryName>Eclipse Web Addons</repositoryName>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
