 org.eclipse.core.runtime;bundle-version="3.30.0"
Service-Component: OSGI-INF/windowThemeListener.xml
Import-Package: javax.xml.parsers,
 org.osgi.service.event,
 org.w3c.dom,
 org.xml.sax
Export-Package: io.github.jollygood1.syntaxthemes
